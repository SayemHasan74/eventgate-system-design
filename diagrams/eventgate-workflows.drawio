<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="29.0.0">
  <diagram id="eventgate-workflows-0" name="EventGate reservation and verified payment workflow">
    <mxGraphModel dx="1320" dy="1160" grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="1160" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="EventGate reservation and verified payment workflow" style="text;html=0;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#172d40;" vertex="1" parent="1">
          <mxGeometry x="28" y="15" width="1264" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Solid arrows carry requests and results. Dashed arrows indicate asynchronous work. Database is authoritative." style="text;html=0;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#172d40;" vertex="1" parent="1">
          <mxGeometry x="28" y="54" width="1264" height="32" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;1 Client and BFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Attendee selects tier and quantity&lt;br&gt;BFF attaches access token and CSRF&lt;br&gt;POST /api/v1/orders" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="108" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="route" value="&lt;b&gt;2 API route and middleware&lt;/b&gt;&lt;br&gt;&lt;br&gt;Request ID and rate limiting&lt;br&gt;Authenticate active attendee&lt;br&gt;Validate UUID, quantity and key" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="473" y="108" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="controller" value="&lt;b&gt;3 Order controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read Idempotency-Key&lt;br&gt;Pass trusted attendee identity&lt;br&gt;Call createOrder service" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="108" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="service" value="&lt;b&gt;4 Order service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Check idempotency and request hash&lt;br&gt;Lock event and ticket tier&lt;br&gt;Validate sale window and inventory" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="405" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;5 Prisma and PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Serializable transaction&lt;br&gt;Reserve stock and create order&lt;br&gt;Write idempotency record and audit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#eff4e9;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="473" y="405" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="response" value="&lt;b&gt;6 API response to client&lt;/b&gt;&lt;br&gt;&lt;br&gt;201 with authoritative order&lt;br&gt;Hold expires after 15 minutes&lt;br&gt;Error middleware formats failures" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="405" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="checkout" value="&lt;b&gt;7 Checkout and SSLCommerz&lt;/b&gt;&lt;br&gt;&lt;br&gt;Client requests hosted checkout&lt;br&gt;Persist attempt before provider call&lt;br&gt;200 checkout URL or 202 processing" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="718" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="callback" value="&lt;b&gt;8 Callback and background job&lt;/b&gt;&lt;br&gt;&lt;br&gt;Persist callback and deduplicate&lt;br&gt;Worker validates with provider API&lt;br&gt;Do not trust browser success URL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="473" y="718" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="fulfilled" value="&lt;b&gt;9 Verified settlement&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transaction settles stock and order&lt;br&gt;Issue one ticket per paid quantity&lt;br&gt;Client reads status and private QR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#eff4e9;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="718" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="&lt;b&gt;Failure paths&lt;/b&gt;&lt;br&gt;&lt;br&gt;400 validation | 401 session | 403 role | 404 hidden resource | 409 stock, state or idempotency conflict&lt;br&gt;Provider uncertainty remains PROCESSING or UNKNOWN. A timeout is never interpreted as a successful payment." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#fff3e6;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="1040" width="1260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="client" target="route">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="validated request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="route" target="controller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="business command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="controller" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="read and write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="service" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="commit or rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="db" target="response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="JSON response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="response" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="next user action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="response" target="checkout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="provider callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="checkout" target="callback">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-8" value="verified outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="callback" target="fulfilled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="eventgate-workflows-1" name="EventGate backend architecture">
    <mxGraphModel dx="1320" dy="890" grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="890" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="EventGate backend architecture" style="text;html=0;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#172d40;" vertex="1" parent="1">
          <mxGeometry x="28" y="15" width="1264" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A modular monolith with a browser BFF, a relational source of truth and durable background work" style="text;html=0;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#172d40;" vertex="1" parent="1">
          <mxGeometry x="28" y="54" width="1264" height="32" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browser or API consumer&lt;br&gt;Sends user intent&lt;br&gt;Renders success and retry states" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="110" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="&lt;b&gt;Browser BFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same origin browser endpoints&lt;br&gt;HttpOnly cookie and Redis session&lt;br&gt;CSRF checks for mutations" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="473" y="110" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Express API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Request ID and rate limiting&lt;br&gt;JWT identity and active user checks&lt;br&gt;Role and schema middleware" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="110" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="controller" value="&lt;b&gt;Route and controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Map method and path to action&lt;br&gt;Extract validated input and identity&lt;br&gt;Format JSON and HTTP status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="395" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="service" value="&lt;b&gt;Domain services&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ownership and business rules&lt;br&gt;Idempotency and state transitions&lt;br&gt;Define transaction boundaries" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="473" y="395" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="orm" value="&lt;b&gt;Prisma and PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Queries, constraints and relations&lt;br&gt;Row locks and serializable writes&lt;br&gt;Source of truth for stock and money" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#eff4e9;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="395" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Durable jobs and integrations&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reservation expiry and reconciliation&lt;br&gt;SSLCommerz, Google and email&lt;br&gt;Leases, retry limits and audit trail" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="680" width="815" height="155" as="geometry" />
        </mxCell>
        <mxCell id="errors" value="&lt;b&gt;Central error handling&lt;/b&gt;&lt;br&gt;&lt;br&gt;AppError becomes safe envelope&lt;br&gt;Unexpected faults logged with ID&lt;br&gt;Secrets excluded from responses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#fff3e6;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="680" width="370" height="155" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="client" target="bff">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="Bearer API request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="bff" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="validated request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="api" target="controller">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="command or query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="controller" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="data access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="service" target="orm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="durable job state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="orm" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="reconcile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="worker" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;dashed=0;" edge="1" parent="1" source="service" target="errors">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>