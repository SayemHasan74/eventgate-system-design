        <mxCell id="edge-4" value="" style="edgeStyle=none;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#557087;endArrow=block;endFill=1;exitX=0;exitY=0.5933333333333334;entryX=1;entryY=0.4066666666666667;exitPerimeter=0;entryPerimeter=0;dashed=0;" edge="1" parent="1" source="db" target="response">
