  <diagram id="eventgate-workflows-1" name="EventGate backend architecture">
    <mxGraphModel dx="1320" dy="730" grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="730" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="EventGate backend architecture" style="text;html=0;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#172d40;" vertex="1" parent="1">
          <mxGeometry x="28" y="15" width="1264" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A modular monolith with a browser BFF, a relational source of truth and durable background work" style="text;html=0;align=left;verticalAlign=middle;fontSize=15;fontStyle=0;fontColor=#172d40;" vertex="1" parent="1">
          <mxGeometry x="28" y="54" width="1264" height="32" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;br&gt;Browser or API consumer&lt;br&gt;Sends user intent&lt;br&gt;Renders success and retry states" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="110" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="&lt;b&gt;Browser BFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same origin browser endpoints&lt;br&gt;HttpOnly cookie and Redis session&lt;br&gt;CSRF checks for mutations" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="473" y="110" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Express API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Request ID and rate limiting&lt;br&gt;JWT identity and active user checks&lt;br&gt;Role and schema middleware" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="110" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="controller" value="&lt;b&gt;Route and controller&lt;/b&gt;&lt;br&gt;&lt;br&gt;Map method and path to action&lt;br&gt;Extract validated input and identity&lt;br&gt;Format JSON and HTTP status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="330" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="service" value="&lt;b&gt;Domain services&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ownership and business rules&lt;br&gt;Idempotency and state transitions&lt;br&gt;Define transaction boundaries" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="473" y="330" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="orm" value="&lt;b&gt;Prisma and PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Queries, constraints and relations&lt;br&gt;Row locks and serializable writes&lt;br&gt;Source of truth for stock and money" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#eff4e9;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="330" width="370" height="132" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Durable jobs and integrations&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reservation expiry and reconciliation&lt;br&gt;SSLCommerz, Google and email&lt;br&gt;Leases, retry limits and audit trail" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#e9f1f8;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="28" y="550" width="815" height="155" as="geometry" />
        </mxCell>
        <mxCell id="errors" value="&lt;b&gt;Central error handling&lt;/b&gt;&lt;br&gt;&lt;br&gt;AppError becomes safe envelope&lt;br&gt;Unexpected faults logged with ID&lt;br&gt;Secrets excluded from responses" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#fff3e6;strokeColor=#657c8f;" vertex="1" parent="1">
          <mxGeometry x="918" y="550" width="370" height="155" as="geometry" />
